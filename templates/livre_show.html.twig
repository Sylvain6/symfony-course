{% extends 'base.html.twig' %}

{% block title %}{{ livre.titre }}{% endblock %}

{% block body %}
    <h1>{{ livre.titre }}</h1>
    <p>Auteur : {{ livre.auteur }}</p>
    <p>Ajouté le {{ livre.createdAt|date('d/m/Y à H:i') }}</p>

    <a href="{{ path('selection_livre') }}">Retour à la sélection</a>
{% endblock %}