{% extends 'base.html.twig' %}

{% block title %}Emprunt index{% endblock %}

{% block body %}
    <h1>Emprunt index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateEmprunt</th>
                <th>DateRetourPrevu</th>
                <th>DateRetour</th>
                {% if (app.user is not null) and ('ROLE_ADMIN' in app.user.getroles()) %}
                    <th>actions</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for emprunt in emprunts %}
            <tr>
            {% if (app.user is not null) and ('ROLE_ADMIN' in app.user.getroles()) or (app.user is not null) and (app.user == emprunt.membre) %}
                <td>{{ emprunt.id }}</td>
                <td>{{ emprunt.dateEmprunt ? emprunt.dateEmprunt|date('Y-m-d') : '' }}</td>
                <td>{{ emprunt.dateRetourPrevu ? emprunt.dateRetourPrevu|date('Y-m-d') : '' }}</td>
                <td>{{ emprunt.dateRetour ? emprunt.dateRetour|date('Y-m-d') : '' }}</td>
                {% if (app.user is not null) and ('ROLE_ADMIN' in app.user.getroles()) %}
                    <td>
                        <a href="{{ path('app_emprunt_show', {'id': emprunt.id}) }}">show</a>
                        <a href="{{ path('app_emprunt_edit', {'id': emprunt.id}) }}">edit</a>
                    </td>
                {% endif %}
            {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if (app.user is not null) and ('ROLE_ADMIN' in app.user.getroles()) %}
        <a href="{{ path('app_emprunt_new') }}">Create new</a>
    {% endif %}
{% endblock %}
