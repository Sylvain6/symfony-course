# Copiez ce fichier en .env.local pour surcharger la configuration sur VOTRE poste.
# .env.local n'est jamais versionné : c'est là que vont vos réglages personnels.
#
# Exemple : vous avez changé le port de MySQL, ou vous utilisez une autre base.
# DATABASE_URL="mysql://root:root@database:3306/app?serverVersion=8.4&charset=utf8mb4"
